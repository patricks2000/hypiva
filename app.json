{
  "expo": {
    "name": "Clipwage",
    "slug": "clipwage",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.clipwage",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0E13",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.clipwage"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Clipwage",
      "shortName": "Clipwage",
      "description": "Post for brands. Get paid for your views.",
      "themeColor": "#0D0E13",
      "backgroundColor": "#0D0E13",
      "display": "standalone",
      "lang": "en"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      [
        "expo-media-library",
        {
          "photosPermission": "Clipwage saves campaign slides to your photos so you can post them.",
          "savePhotosPermission": "Clipwage saves campaign slides to your photos so you can post them.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick images to add as campaign content.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-localization"
    ],
    "scheme": "clipwage",
    "backgroundColor": "#0D0E13"
  }
}
